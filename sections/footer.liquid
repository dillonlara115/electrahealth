{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'section-footer-custom.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<footer class="footer footer--custom section-{{ section.id }}-padding">
  {%- comment -%} Top Section with Links {%- endcomment -%}
  <div class="footer-top">
    <div class="footer-container page-width">
      <div class="footer-columns">
        {%- comment -%} Column 1 {%- endcomment -%}
        <div class="footer-column">
          {%- if section.settings.link_1_text != blank -%}
            <a href="{{ section.settings.link_1_url }}" class="footer-link">{{ section.settings.link_1_text }}</a>
          {%- endif -%}
          {%- if section.settings.link_2_text != blank -%}
            <a href="{{ section.settings.link_2_url }}" class="footer-link">{{ section.settings.link_2_text }}</a>
          {%- endif -%}
          {%- if section.settings.link_3_text != blank -%}
            <a href="{{ section.settings.link_3_url }}" class="footer-link">{{ section.settings.link_3_text }}</a>
          {%- endif -%}
        </div>

        {%- comment -%} Column 2 {%- endcomment -%}
        <div class="footer-column">
          {%- if section.settings.link_4_text != blank -%}
            <a href="{{ section.settings.link_4_url }}" class="footer-link">{{ section.settings.link_4_text }}</a>
          {%- endif -%}
          {%- if section.settings.link_5_text != blank -%}
            <a href="{{ section.settings.link_5_url }}" class="footer-link">{{ section.settings.link_5_text }}</a>
          {%- endif -%}
          {%- if section.settings.link_8_text != blank -%}
            <a href="{{ section.settings.link_8_url }}" class="footer-link">{{ section.settings.link_8_text }}</a>
          {%- endif -%}
        </div>

        {%- comment -%} Column 3 {%- endcomment -%}
        <div class="footer-column">
          {%- if section.settings.link_6_text != blank -%}
            <a
              href="{{ section.settings.link_6_url }}"
              class="footer-link"
              {% if section.settings.link_6_external %}
                target="_blank" rel="noopener noreferrer"
              {% endif %}
            >
              {{- section.settings.link_6_text -}}
            </a>
          {%- endif -%}
          {%- if section.settings.link_7_text != blank -%}
            <a href="{{ section.settings.link_7_url }}" class="footer-link">{{ section.settings.link_7_text }}</a>
          {%- endif -%}
          {%- if section.settings.link_9_text != blank -%}
            <a href="{{ section.settings.link_9_url }}" class="footer-link">{{ section.settings.link_9_text }}</a>
          {%- endif -%}
        </div>

        {%- comment -%} Column 4 - Stay Connected {%- endcomment -%}
        <div class="footer-column footer-column-social">
          <h3 class="footer-social-heading">STAY CONNECTED</h3>
          <div class="footer-social-icons">
            {%- if settings.social_facebook_link != blank -%}
              <a
                href="{{ settings.social_facebook_link }}"
                class="footer-social-icon"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
              >
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3V2z" fill="currentColor"/>
                </svg>
              </a>
            {%- endif -%}
            {%- if settings.social_youtube_link != blank -%}
              <a
                href="{{ settings.social_youtube_link }}"
                class="footer-social-icon"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="YouTube"
              >
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" fill="currentColor"/>
                </svg>
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Separator Line {%- endcomment -%}
  <div class="footer-separator"></div>

  {%- comment -%} Bottom Section {%- endcomment -%}
  <div class="footer-bottom">
    <div class="footer-container page-width">
      <div class="footer-bottom-content">
        <div class="footer-bottom-left">
          <div class="footer-domain">ElectraHealth.com</div>
          <div class="footer-copyright">
            Copyright ElectraHealth.com. All Rights Reserved. Accessing or using this website is strictly and explicitly
            restricted. All parties hereby agree to the
            <a href="{{ shop.policies.terms_of_service.url }}" class="footer-terms-link">Terms and Conditions</a> or
            must immediately cease use and end this session.
          </div>
        </div>
        <div class="footer-bottom-right">
          {%- if section.settings.show_payment_icons -%}
            <div class="footer-payment-logos">
              <div class="payment-logo" aria-label="Visa">
                <i class="fa-brands fa-cc-visa"></i>
              </div>
              <div class="payment-logo" aria-label="Mastercard">
                <i class="fa-brands fa-cc-mastercard"></i>
              </div>
              <div class="payment-logo" aria-label="American Express">
                <i class="fa-brands fa-cc-amex"></i>
              </div>
              <div class="payment-logo" aria-label="Discover">
                <i class="fa-brands fa-cc-discover"></i>
              </div>
              <div class="payment-logo" aria-label="PayPal">
                <i class="fa-brands fa-cc-paypal"></i>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Quick links",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "default": "<p>Share contact information, store details, and brand content with your customers.</p>",
          "label": "Subtext"
        }
      ]
    },
    {
      "type": "brand_information",
      "name": "Brand Information",
      "settings": [
        {
          "type": "paragraph",
          "content": "Brand information is managed in [Theme Settings](/admin/themes/current/editor?context=theme&category=brand%20information)"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "default": true,
          "label": "Show social media icons",
          "info": "Manage social accounts in [Theme Settings](/admin/themes/current/editor?context=theme&category=social%20media)"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 50,
          "max": 550,
          "step": 5,
          "unit": "px",
          "label": "Width",
          "default": 100
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alignment",
          "options": [
            {
              "value": "",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Column 1 Links"
    },
    {
      "type": "text",
      "id": "link_1_text",
      "label": "Link 1 Text",
      "default": "EMF Fact Page"
    },
    {
      "type": "url",
      "id": "link_1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "text",
      "id": "link_2_text",
      "label": "Link 2 Text",
      "default": "Terms and Conditions"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "Link 2 URL"
    },
    {
      "type": "text",
      "id": "link_3_text",
      "label": "Link 3 Text",
      "default": "Research Feed"
    },
    {
      "type": "url",
      "id": "link_3_url",
      "label": "Link 3 URL"
    },
    {
      "type": "header",
      "content": "Column 2 Links"
    },
    {
      "type": "text",
      "id": "link_4_text",
      "label": "Link 4 Text",
      "default": "Reviews"
    },
    {
      "type": "url",
      "id": "link_4_url",
      "label": "Link 4 URL"
    },
    {
      "type": "text",
      "id": "link_5_text",
      "label": "Link 5 Text",
      "default": "Become an Affiliate"
    },
    {
      "type": "url",
      "id": "link_5_url",
      "label": "Link 5 URL"
    },
    {
      "type": "text",
      "id": "link_8_text",
      "label": "Link 8 Text",
      "default": "Videos"
    },
    {
      "type": "url",
      "id": "link_8_url",
      "label": "Link 8 URL"
    },
    {
      "type": "header",
      "content": "Column 3 Links"
    },
    {
      "type": "text",
      "id": "link_6_text",
      "label": "Link 6 Text",
      "default": "Buy on Amazon"
    },
    {
      "type": "url",
      "id": "link_6_url",
      "label": "Link 6 URL"
    },
    {
      "type": "checkbox",
      "id": "link_6_external",
      "label": "Open Link 6 in New Tab",
      "default": true
    },
    {
      "type": "text",
      "id": "link_7_text",
      "label": "Link 7 Text",
      "default": "Wholesale Program"
    },
    {
      "type": "url",
      "id": "link_7_url",
      "label": "Link 7 URL"
    },
    {
      "type": "text",
      "id": "link_9_text",
      "label": "Link 9 Text",
      "default": "Blog"
