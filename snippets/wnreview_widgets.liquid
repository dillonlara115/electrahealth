{% if widget_type == 'wnreview_ai_story' %}
  {% if shop.metafields.wisernotify.app_status.value != 'false' %}
  <div
    data-type="ai_story"
    class="wiser_review_ai_story"
    style="display: none;">

    {% assign data = product.metafields.wisernotify.ai_story_widget.value.data %}
    {% assign dataCount = product.metafields.wisernotify.ai_story_widget.value.dataCount %}
    {% assign dataMedia = product.metafields.wisernotify.ai_story_widget.value.dataMedia %}
    {% assign storiesCNF = shop.metafields.wisernotify.ai_story_cnf %}

    {% if request.design_mode %}
      {% comment %} theme-editor preview: dummy_data has data/dataCount/dataMedia but NOT aitopics/topicsmry — theme JS falls back {% endcomment %}
      {% assign data = shop.metafields.wisernotify.dummy_data.value.data %}
      {% assign dataCount = shop.metafields.wisernotify.dummy_data.value.dataCount %}
      {% assign dataMedia = shop.metafields.wisernotify.dummy_data.value.dataMedia %}
    {% endif %}

    {% assign arrDisablePid = shop.metafields.wisernotify.arr_disable_pid.value %}
    {% assign current_product_id_string = product.id | append: '' %}
    {% assign prtngCount = dataCount.prtng | default: 0 %}

  </div>

  {% unless arrDisablePid contains current_product_id_string %}
    {% if prtngCount > 0 or request.design_mode %}
      <script>
        flagIsFromIframe_WDSHPRV = false;

        var respDataForAiStories = {
          wdtyp: "ai_story",
          dataObj: {
            wdtyp: "ai_story",
            wsid: "{{ storiesCNF.value.wsid }}",
            cnf: {{ storiesCNF.value.cnf | json }},
            data: {{ data | json }},
            dataCount: {{ dataCount | json }},
            dataMedia: {{ dataMedia | json }},
            htmlLayout: "{{ storiesCNF.value.htmlLayout }}",
            _id: "{{ storiesCNF.value._id }}",
            objProduct: {
              product_title: `{{ product.title }}`,
              product_type: `{{ product.type }}`,
              product_id: `{{ product.id }}`,
              product_url: `{{ shop.url }}{{ product.url }}`,
              product_img: `{{ product.featured_image | image_url: width: 200 }}`
            }
          }
        };

        if (typeof arrRespData_WDSHPRV !== 'undefined') {
          arrRespData_WDSHPRV.push(respDataForAiStories);
        } else {
          arrRespData_WDSHPRV = [respDataForAiStories];
        }

        function loadAiStoriesResources() {
          const e = (file, tag, attr, rel, defer = false) => {
            const a = document.createElement(tag);
            a[attr] = "https://embed.wiserreview.com/pixel/theme/" + file;
            if (rel) a.rel = rel;
            if (defer && tag === "script") a.defer = true;
            document.getElementsByTagName("head")[0].appendChild(a);
          };
          setTimeout(() => {
            e("ai_story/ws_theme.css", "link", "href", "stylesheet"),
            e("ai_story/ws_theme.js", "script", "src", null, true);
          }, 1000);
        }
        window.addEventListener("DOMContentLoaded", loadAiStoriesResources);
      </script>

      {% assign ai_stories_dynamic_css_enable = storiesCNF.value.cnf.icstcss | default: false %}
      {% assign ai_stories_dynamic_css = storiesCNF.value.cnf.cstcss %}
      <script>
        if ({{ ai_stories_dynamic_css_enable }}) {
          let cssWithClassName = `{{ ai_stories_dynamic_css }}`.replace(/\n/gi, '').split('}').map(rule => rule ? ('[data-type="ai_story"] ' + rule + '}') : '').join('');
          var style = document.createElement("style");
          style.innerHTML = cssWithClassName;
          document.head.appendChild(style);
        }
      </script>
    {% endif %}
  {% endunless %}

{% endif %}
{% endif %}

