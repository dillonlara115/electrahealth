{% if widget_type == 'wnreview_ugc' %}
  {% if shop.metafields.wisernotify.app_status.value != 'false' %}

  <div
    data-type="ugc"
    class="wiser_review_ugc"
    data-id="{{ shop.metafields.wisernotify.ugc.value._id }}"></div>
  <script>
